               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>
                  <content styleCode="italics">Warnings</content>
               </title>
               <effectiveTime value="20150706"/>
               <component>
                  <section ID="ID_491e8288-8fc9-4cea-9325-d81eb6e8f3ff">
                     <id root="87c17ae9-10a1-1b1b-e053-2a95a90a749d"/>
                     <code code="50568-5" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR/PHARMACIST SECTION"/>
                     <title>
                        <content styleCode="bold">Ask a doctor or pharmacist before use if you are</content>
                     </title>
                     <text>
                        <list listType="unordered">
                           <item>presently taking a prescription drug. Antacids may interact with certain prescription drugs.</item>
                        </list>
                     </text>
                     <effectiveTime value="20171122"/>
                  </section>
               </component>
               <component>
                  <section ID="ID_aa5862a2-3897-475d-aa6d-0318cc6c069c">
                     <id root="87c17be3-3e2b-9199-e053-2995a90af4ad"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>
                        <content styleCode="bold">When using this product</content>
                     </title>
                     <text>
                        <paragraph>do not take more than 15 tablets in a 24-hour period, or use the maximum dosage of this product for more than 2 weeks, except under the advice and supervision of a doctor.</paragraph>
                     </text>
                     <effectiveTime value="20171122"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_5e9630d6-f96e-bbe0-e053-2a91aa0a9360">
                     <id root="87c17be3-3e2c-9199-e053-2995a90af4ad"/>
                     <code code="53414-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PREGNANCY OR BREAST FEEDING SECTION"/>
                     <title>
                        <content styleCode="bold">If pregnant or breast-feeding, ask a health professional before use.</content>
                     </title>
                     <effectiveTime value="20171122"/>
                  </section>
               </component>
               <component>
                  <section ID="ID_fcb0503b-e751-4189-94b1-395717c9dd76">
                     <id root="87c17be3-3e2d-9199-e053-2995a90af4ad"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>
                        <content styleCode="bold">Keep out of reach of children.</content>
                     </title>
                     <effectiveTime value="20150629"/>
                  </section>
               </component>
            </section>
