         <component>
            <section ID="ID_4e09f64b-3aad-4ff5-84a8-599cfc260938">
               <id root="87c17be3-3e2e-9199-e053-2995a90af4ad"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">adults and children 12 years of age and over:</content> chew 2-4 tablets as symptoms occur, or as directed by a doctor.
  
       
 
  </item>
                  </list>
               </text>
               <effectiveTime value="20171122"/>
            </section>
         </component>
