               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>
                  <content styleCode="italics">Other Information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">each tablet contains:</content> elemental calcium 200 mg
  
       
 
  </item>
                     <item>store at room temperature.</item>
                     <item>
                        <content styleCode="bold">FOR YOUR PROTECTION:</content> Do not use if blister is torn or broken.
  
       
 
  </item>
                  </list>
               </text>
               <effectiveTime value="20171122"/>
            </section>
         </component>
